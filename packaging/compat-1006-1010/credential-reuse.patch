+class CredentialSnapshot final : public ICredentialStorage {
+ public:
+  std::array<std::optional<security::SecureBuffer>, 4> values;
+  std::optional<security::SecureBuffer> read(CredentialEntry entry) override {
+    const auto& value = values.at(static_cast<std::size_t>(entry));
+    if (!value) return std::nullopt;
+    security::SecureBuffer copy(value->size());
+    std::ranges::copy(value->bytes(), copy.bytes().begin());
+    return copy;
+  }
