+VikeyCredentialSet load_compatible_credentials(
+    ICredentialStorage& local, ICredentialStorage& main_application) {
+  CredentialSnapshot snapshot;
+  bool local_present = false;
+  try {
+    snapshot.values[0] = local.read(CredentialEntry::bundle);
+    local_present = snapshot.values[0].has_value();
+    if (!local_present) {
+      for (const auto entry : {CredentialEntry::legacy_sn,
+                              CredentialEntry::legacy_key,
+                              CredentialEntry::legacy_pin}) {
+        auto& value = snapshot.values[static_cast<std::size_t>(entry)];
+        value = local.read(entry);
+        local_present = local_present || value.has_value();
+      }
+    }
+  } catch (const std::system_error& e) {
+    throw DiagnosticError(make_error_code(CardError::backend_unavailable),
+        DiagnosticStage::credential_sn, "read test build credentials",
+        static_cast<std::uint32_t>(e.code().value()), NativeCodeKind::win32);
+  } catch (...) {
+    throw DiagnosticError(make_error_code(CardError::invalid_configuration),
+        DiagnosticStage::credential_sn, "invalid test build credentials");
+  }
+  // A snapshot avoids selecting a namespace based on one read and then
+  // consuming a different local set. A partial or malformed set fails closed.
+  return local_present ? load_credentials(snapshot)
+                       : load_credentials(main_application);
+}
