+void test_read_only_main_application_fallback() {
+  FakeStorage local, main_application;
+  auto main_sample = sample_credentials();
+  dev::store_credentials(main_application, main_sample);
+  main_application.writes = 0;
+  const auto main_values = main_application.values;
+  auto reused = dev::load_compatible_credentials(local, main_application);
+  expect(reused.user_sn.bytes()[0] == std::byte{'a'} &&
+         reused.api_key.bytes()[0] == std::byte{'b'} &&
+         reused.user_pin.bytes()[0] == std::byte{'1'},
+         "missing test credentials did not reuse the complete main bundle");
+  expect(local.writes == 0 && main_application.writes == 0 &&
+         main_application.values == main_values,
+         "fallback copied or changed saved credentials");
+
+  auto own_sample = sample_credentials();
+  own_sample.user_sn.bytes()[0] = std::byte{'c'};
+  dev::store_credentials(local, own_sample);
+  main_application.reads = 0;
+  auto own = dev::load_compatible_credentials(local, main_application);
+  expect(own.user_sn.bytes()[0] == std::byte{'c'} && main_application.reads == 0,
+         "local bundle did not override the main credentials");
+  expect(main_application.values == main_values && main_application.writes == 0,
+         "saving local credentials modified the main application");
+
+  local.values[0]->pop_back();
+  expect_failure([&] { static_cast<void>(dev::load_compatible_credentials(local, main_application)); });
+  expect(main_application.reads == 0, "malformed local bundle fell back to main");
+  local.values[0].reset();
+  local.values[1] = std::vector<std::byte>(32, std::byte{'d'});
+  expect_failure([&] { static_cast<void>(dev::load_compatible_credentials(local, main_application)); });
+  expect(main_application.reads == 0, "partial local credentials merged with main");
+  local.values[1].reset();
+  local.read_denied = true;
+  expect_failure([&] { static_cast<void>(dev::load_compatible_credentials(local, main_application)); });
+  expect(main_application.reads == 0, "local access denial fell back to main");
+  local.read_denied = false;
+  main_application.read_denied = true;
+  expect_failure([&] { static_cast<void>(dev::load_compatible_credentials(local, main_application)); });
+  main_application.read_denied = false;
+  main_application.values[0]->pop_back();
+  expect_failure([&] { static_cast<void>(dev::load_compatible_credentials(local, main_application)); });
+
+  FakeStorage legacy_main, empty_local;
+  legacy_main.values[1] = std::vector<std::byte>(32, std::byte{'a'});
+  legacy_main.values[2] = std::vector<std::byte>(128, std::byte{'b'});
+  legacy_main.values[3] = std::vector<std::byte>(8, std::byte{'1'});
+  auto legacy = dev::load_compatible_credentials(empty_local, legacy_main);
+  expect(legacy.user_sn.bytes()[0] == std::byte{'a'} &&
+         empty_local.writes == 0 && legacy_main.writes == 0,
+         "legacy main credentials were not reused read-only");
+}
