+  SecureBuffer from_newer = append_and_check(dual, "dual-pw-new",
+                                             "dual-pw-third", 1);
+  expect_opens(from_newer, "dual-pw-old", root, "other v1 password was lost");
+  expect_opens(from_newer, "dual-pw-new", root, "v1 login password was lost");
+}
