+  Response response{};
+  response.security_properties = kDevelopmentCompatibilitySecurityProperties;
+  response.payload_bytes = static_cast<std::uint32_t>(kCardRecordV1ThreeSlotSize);
+  response.nonce[9] = std::byte{0x43};
