get_filename_component(repository "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(production IN ITEMS OFF ON)
  foreach(logging IN ITEMS OFF ON)
    execute_process(
      COMMAND "${CMAKE_COMMAND}"
        "-DUSB_VAULT_PRODUCTION_RELEASE=${production}"
        "-DUSB_VAULT_DEBUG_LOG=${logging}"
        -P "${repository}/tools/debug-log-policy.cmake"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(production AND logging)
      if(result EQUAL 0 OR NOT error MATCHES "requires USB_VAULT_DEBUG_LOG=OFF")
        message(FATAL_ERROR "Public release with logging was not rejected: ${output}${error}")
      endif()
    elseif(NOT result EQUAL 0)
      message(FATAL_ERROR "Allowed logging configuration failed: ${output}${error}")
    endif()
  endforeach()
endforeach()

file(READ "${repository}/CMakePresets.json" presets)
string(JSON count LENGTH "${presets}" configurePresets)
math(EXPR last "${count} - 1")
set(found 0)
foreach(index RANGE 0 ${last})
  string(JSON name GET "${presets}" configurePresets ${index} name)
  if(name STREQUAL "package-release" OR name STREQUAL "package-production")
    string(JSON production GET "${presets}" configurePresets ${index} cacheVariables USB_VAULT_PRODUCTION_RELEASE)
    string(JSON logging GET "${presets}" configurePresets ${index} cacheVariables USB_VAULT_DEBUG_LOG)
    if(name STREQUAL "package-release")
      if(production OR NOT logging)
        message(FATAL_ERROR "Test packages must explicitly retain diagnostic logs")
      endif()
    elseif(NOT production OR logging)
      message(FATAL_ERROR "Public packages must select the release gate and disable diagnostic logs")
    endif()
    math(EXPR found "${found} + 1")
  endif()
endforeach()
if(NOT found EQUAL 2)
  message(FATAL_ERROR "Both package policies must be explicit")
endif()
message(STATUS "Release logging policy matrix and presets passed")
