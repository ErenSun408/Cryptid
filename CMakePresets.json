{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USB_VAULT_ENABLE_ASAN": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "USB_VAULT_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "analyze",
      "displayName": "MSVC Code Analysis",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USB_VAULT_ENABLE_ASAN": "OFF",
        "USB_VAULT_ENABLE_CODE_ANALYSIS": "ON"
      }
    },
    {
      "name": "integration",
      "displayName": "Local VeraCrypt Integration",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USB_VAULT_ENABLE_ASAN": "OFF",
        "USB_VAULT_ENABLE_INTEGRATION_TESTS": "ON"
      }
    },
    {
      "name": "integration-release",
      "displayName": "Optimized Local VeraCrypt Integration",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USB_VAULT_ENABLE_ASAN": "OFF",
        "USB_VAULT_ENABLE_INTEGRATION_TESTS": "ON"
      }
    },
    {
      "name": "package-release",
      "displayName": "P2 Development Package (static MSVC runtime)",
      "inherits": "base",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "USB_VAULT_ENABLE_ASAN": "OFF",
        "USB_VAULT_ENABLE_CODE_ANALYSIS": "OFF",
        "USB_VAULT_ENABLE_INTEGRATION_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "analyze",
      "configurePreset": "analyze"
    },
    {
      "name": "integration",
      "configurePreset": "integration"
    },
    {
      "name": "integration-release",
      "configurePreset": "integration-release"
    },
    {
      "name": "package-release",
      "configurePreset": "package-release",
      "targets": [
        "usb_vault_p2_development_package_binaries"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "analyze",
      "configurePreset": "analyze",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "integration",
      "configurePreset": "integration",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "integration-release",
      "configurePreset": "integration-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
