+	}
+
+	/* ---- Added by usb-vault Spike 3b (not part of the official SDK) ----
+	 *
+	 * Headless wrapper around ChangePwd() (Common/Password.c:190).
+	 * Needed by main-doc N-06 when container A's password must be re-keyed
+	 * from KDF(S, user input)
+	 * to KDF(S, "diskA").
+	 *
+	 * Two things are required to keep this GUI-free:
+	 *   1. Silent == TRUE, already set by VeraCryptFormat_Initialize(), makes
+	 *      handleError() a no-op (Dlgcode.c: "if (Silent) return;").
+	 *   2. SetRandomPoolEnrichedByUserStatus(TRUE) — otherwise
+	 *      UserEnrichRandomPool() (Dlgcode.c:7421) pops the "move your mouse"
+	 *      DialogBoxParamW. Silent does NOT cover this one.
+	 *
+	 * Passing a non-zero newPrf also short-circuits the CheckPasswordLength()
+	 * branch, which is a further GUI path. We want an explicit PRF anyway
+	 * (Spike 6: mounting must not use PRF auto-detection).
+	 */
+	VCF_API int __cdecl VeraCryptFormat_ChangePassword(
+		const wchar_t* path,
+		const char* oldPassword, int oldPim, const wchar_t* oldHash,
+		const char* newPassword, int newPim, const wchar_t* newHash)
+	{
+		if (!g_isInitialized) return VCF_ERROR_NOT_INITIALIZED;
+		if (!path || !oldPassword || !newPassword) return VCF_ERROR_INVALID_PARAMETER;
+
+		size_t oldLen = strlen(oldPassword);
+		size_t newLen = strlen(newPassword);
+		if (oldLen == 0 || oldLen > VC_MAX_PASSWORD) return VCF_ERROR_PASSWORD_POLICY;
+		if (newLen == 0 || newLen > VC_MAX_PASSWORD) return VCF_ERROR_PASSWORD_POLICY;
+
+		std::lock_guard<std::mutex> lock(g_sdkMutex);
+
+		Password oldPwd = { 0 };
+		Password newPwd = { 0 };
+		memcpy(oldPwd.Text, oldPassword, oldLen);
+		oldPwd.Length = (unsigned __int32)oldLen;
+		memcpy(newPwd.Text, newPassword, newLen);
+		newPwd.Length = (unsigned __int32)newLen;
+
+		int oldPrf = MapHashAlgorithm(oldHash);   // 0 == auto-detect on open
+		int newPrf = MapHashAlgorithm(newHash);
+		if (newHash && newPrf == 0) return VCF_ERROR_INVALID_HASH_ALGORITHM;
+
+		// Suppress the random-pool enrichment dialog; Silent does not cover it.
+		SetRandomPoolEnrichedByUserStatus(TRUE);
+
+		int status = ChangePwd(path, &oldPwd, oldPrf, oldPim,
+		                             &newPwd, newPrf, newPim,
+		                             1 /* wipePassCount */, NULL /* hwndDlg */);
+
+		burn(&oldPwd, sizeof(oldPwd));
+		burn(&newPwd, sizeof(newPwd));
+
+		// ChangePwd returns 0 on success, otherwise a VeraCrypt ERR_* code.
+		// The spike only needs success/failure plus the raw code for diagnosis,
+		// so the raw code is returned shifted out of the VCF_* range.
+		return (status == 0) ? VCF_SUCCESS : (1000 + status);
 	}
 
