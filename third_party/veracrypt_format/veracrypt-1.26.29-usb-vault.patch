+	VCF_API int __cdecl VeraCryptFormatBinary(const VeraCryptFormatOptions* options, uint32_t passwordLength)
+	{
+		if (!g_isInitialized)
+		{
+			return VCF_ERROR_NOT_INITIALIZED;
